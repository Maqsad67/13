    INSERT into GL_BALANCE_PRIOR_ADJUSTMENT (batch_id,branch_code,cgl,currency,balance_date,balance,inr_balance)

WITH
    base_data AS (
        SELECT
            CGL,
            CURRENCY,
            BRANCH_CODE,
            BALANCE,
            INR_BALANCE,
            '01-APR-26' AS BALANCE_DATE
        FROM
            GL_BALANCE_PRIOR_ADJUSTMENT
        WHERE
            TRUNC (BALANCE_DATE) = TO_DATE( :P_ADJUSTMENT_DATE  ,'dd-mm-yyyy')
    ),
    fwd_base AS (
        SELECT
            B.CGL,
            B.CURRENCY,
            B.BRANCH_CODE,
            B.BALANCE,
            B.INR_BALANCE,
            B.BALANCE_DATE
        FROM
            base_data B
            INNER JOIN CGL_MASTER C ON TRIM(B.CGL) = TRIM(C.CGL_NUMBER)
        WHERE
            C.BAL_FWD = 1
    ),
    rule_78 AS (
        -- ——————————————————————
        -- – ORIGINAL FOREIGN CURRENCY ROWS
        -- ——————————————————————
        SELECT
            CGL,
            CURRENCY,
            BRANCH_CODE,
            BALANCE_DATE,
            BALANCE,
            INR_BALANCE
        FROM
            base_data
        WHERE
            REGEXP_LIKE (CGL, '^[78]')
            AND TRIM(CURRENCY) <> 'INR'
        UNION ALL
        ------------------------------------------------------------------
        -- OFFSET INR ROWS
        ------------------------------------------------------------------
        SELECT
            CGL,
            'INR' AS CURRENCY,
            BRANCH_CODE,
            BALANCE_DATE,
            - INR_BALANCE AS BALANCE,
            - INR_BALANCE AS INR_BALANCE
        FROM
            base_data
        WHERE
            REGEXP_LIKE (CGL, '^[78]')
            AND TRIM(CURRENCY) <> 'INR'
    ),
    rule_circle AS (
        SELECT
            F.CGL,
            F.CURRENCY,
            F.BRANCH_CODE,
            F.BALANCE_DATE,
            F.BALANCE,
            F.INR_BALANCE
        FROM
            fwd_base F
            INNER JOIN (
                SELECT DISTINCT
                    BRANCH_CODE
                FROM
                    CIRCLE_MASTER
                WHERE
                    BRANCH_CODE IS NOT NULL
            ) C ON F.BRANCH_CODE = C.BRANCH_CODE
        WHERE
            F.CGL = '2110505001'
    ),
    rule_general AS (
        SELECT
            CGL,
            CURRENCY,
            BRANCH_CODE,
            BALANCE_DATE,
            BALANCE,
            INR_BALANCE
        FROM
            fwd_base
        WHERE
            NOT REGEXP_LIKE (CGL, '^[78]')
            AND CGL <> '2110505001'
    ),
    rule_5 AS (
        SELECT
            '5000000000' AS CGL,
            CURRENCY,
            BRANCH_CODE,
            '01-APR-26' AS BALANCE_DATE,
            - SUM(BALANCE) AS BALANCE,
            - SUM(INR_BALANCE) AS INR_BALANCE
        FROM
            GL_BAL B
        WHERE
            TRUNC (B.BALANCE_DATE) = TO_DATE( :P_ADJUSTMENT_DATE  ,'dd-mm-yyyy')
            AND B.CGL LIKE '5%'
            AND EXISTS (
                SELECT
                    1
                FROM
                    CGL_MASTER C
                WHERE
                    TRIM(C.CGL_NUMBER) = TRIM(B.CGL)
                    AND C.BAL_FWD = 1
            )
        GROUP BY
            BRANCH_CODE,
            CURRENCY
    ),
    circle_profit AS (
        SELECT
            '2110505001' AS CGL,
            'INR' AS CURRENCY,
            BRANCH_CODE,
            '01-APR-26' AS BALANCE_DATE,
            PROFIT_LOSS AS BALANCE,
            PROFIT_LOSS AS INR_BALANCE
        FROM
            P_L_TRANSFER
        WHERE
            BRANCH_CODE = CIRCLE_BRANCH_CODE
            AND ACTIVITY_FLAG = 'A'
            AND TRUNC (TRANSFER_DATE) = TO_DATE( :P_ADJUSTMENT_DATE  ,'dd-mm-yyyy')
    ),
    opening_balance AS (
        SELECT
            *
        FROM
            rule_78
        UNION ALL
        SELECT
            *
        FROM
            rule_circle
        UNION ALL
        SELECT
            *
        FROM
            rule_general
        UNION ALL
        SELECT
            *
        FROM
            rule_5
        UNION ALL
        SELECT
            *
        FROM
            circle_profit
    )
SELECT
    v_batch_id,
    BRANCH_CODE,
    CGL,
    CURRENCY,
    '01-APR-26' AS BALANCE_DATE,
    SUM(BALANCE) AS BALANCE,
    SUM(INR_BALANCE) AS INR_BALANCE
FROM
    opening_balance
GROUP BY
    CGL,
    CURRENCY,
    BRANCH_CODE
ORDER BY
    CGL,
    CURRENCY,
    BRANCH_CODE;

