def main(args):
    HDFS_BASE = get_hdfs_base()
    spark = create_spark_session("Profit and Loss Posting", HDFS_BASE)
    today = get_etl_date(spark)
    yesterday = today - timedelta(days=1)
    posting_date_str = today.strftime("%Y%m%d")
    today_str = posting_date_str
    yesterday=yesterday.strftime("%Y-%m-%d")
    today= today.strftime("%Y-%m-%d")
    PROCESS_ID= Process.PROFIT_POSTING
    RUN_ID = get_run_id(spark,today,PROCESS_ID) 
    logger = setup_logger("PL_POSTING", RUN_ID , posting_date_str)
     
    logger.info(f"=== Using current date for POST_DATE: {posting_date_str} ===")
    logger.info(f"RUN_ID as : {RUN_ID}")

    logger.info(f"Fetched oracle properties SUCCESFULLY :)")
    oracle_properties=get_oracle_properties()
    logger.info(oracle_properties)
    hdfs_paths = paths_for_read("glif",today,today_str)

    HDFS_BASE = hdfs_paths["HDFS_BASE"]
    HDFS_PATH = hdfs_paths["HDFS_PATH"]
    GL_DATALAKE_PATH = hdfs_paths["GL_DATALAKE_PATH"]
    manifest_filename = hdfs_paths["manifest_filename"]
    spark_stream_path = hdfs_paths["spark_stream_path"] + manifest_filename
    BASE_MANIFEST_PATH = hdfs_paths["MANIFEST_BASE_PATH"]

    oracle_tables = tables_to_read("glif")

    TRANSACTIONS = oracle_tables["TRANSACTIONS"]
    BALANCE = oracle_tables["BALANCE"]
    INVALID = oracle_tables["INVALID"]
    CGLS = oracle_tables["CGLS"]
    CURRENCY = oracle_tables["CURRENCY"]
    BRANCH = oracle_tables["BRANCH"]
    
    
    process_run_id = sys.argv[1] if len(sys.argv) > 1 else get_process_run_id(spark,PROCESS_ID,today)

    log_etl(spark, process_run_id, "PL_Posting",1,"Posting Pipeline Strarted")
    try:
        load_balance_sql = f"""(select * from P_L_TRANSFER_BALANCE) t1"""
        load_transactions_sql = f"""(select CGL,CURRENCY,BRANCH_CODE,NARRATION,SOURCE_FLAG,BATCH_ID,DEBIT_AMOUNT,CREDIT_AMOUNT,TRANSACTION_COUNT,JOURNAL_ID,TRANSACTION_DATE from P_L_TRANSFER_TRANSACTIONS) t1"""
        log_etl(spark, process_run_id, f"PL_Posting_Loading_balance",1,"Loading the balances from {Balance} table")

        load_balance = read_oracle(spark,load_balance_sql)
        try:
            load_balance = load_balance.withColumn("INR_BALANCE", col("BALANCE"))
            
            log_etl(spark, process_run_id, "PL_Posting_Loading_balance",2)
        except Exception as e:
            print(f"Error {e} while loading data from balance Table") 
            log_etl(spark, process_run_id, "PL_Posting_Loading_balance",3, f"Failed While loading balances Reason: {e}.")
            spark.stop()
            sys.exit(1)
        log_etl(spark, process_run_id, "PL_Posting_Loading_Transactions",1,f"Loading data from {TRANSACTIONS} table")   
        try:
            load_transactions = read_oracle(spark,load_transactions_sql)
            log_etl(spark, process_run_id, "PL_Posting_Loading_Transactions",2,"Successfully load data")
        except Exception as e:
            print(f"Error {e} while loading data from Transactions Table") 
            log_etl(spark, process_run_id, "PL_Posting_Loading_Transactions",3, f"Failed While loading Transactions Reason: {e}.") 
            spark.stop()
            sys.exit(1) 
            
        log_etl(spark, process_run_id, "PL_Posting_Balance",1,"Posting Started")   

        
        
        try:
              oracle_properties=get_oracle_properties()
              logger.info(oracle_properties)
              
      
              JDBC_URL = oracle_properties["url"]
              ORACLE_USER = oracle_properties["user"]
              ORACLE_PASSWORD = oracle_properties["password"]
              ORACLE_DRIVER = oracle_properties["driver"]

              conn = spark._sc._gateway.jvm.java.sql.DriverManager.getConnection(JDBC_URL,ORACLE_USER,ORACLE_PASSWORD)
              merge_sql = f"""
                        MERGE INTO {BALANCE}  target
                        USING  P_L_TRANSFER_BALANCE  source
                        ON (
                              target.cgl = source.cgl
                          AND target.currency = source.currency
                          AND target.branch_code = source.branch_code
                          AND target.balance_date = source.balance_date
                        )
                        WHEN MATCHED THEN
                        UPDATE SET
                           target.balance = NVL(target.balance,0) + source.balance , target.inr_balance = NVL(target.balance,0) + source.balance 
                        WHEN NOT MATCHED THEN
                        INSERT (
                           cgl,
                           currency,
                           branch_code,
                           balance,
                           inr_balance,
                           balance_date
                        )
                        VALUES (
                           source.cgl,
                           source.currency,
                           source.branch_code,
                           source.balance,
                           source.balance,
                           source.balance_date
                        )
                        """  
              conn.setAutoCommit(False)             
              statement = conn.createStatement()
              print("stmt")
              statement.execute(merge_sql)
              print("stmt exec")
              
              conn.commit()
              print("comm comit")
              statement.close()
              print("stmt close")
              conn.close()
              print("conn close")
              print("MERGE executed successfully")              
              log_etl(spark, process_run_id, "PL_Posting_Balance",2,f"Successfully posted in {BALANCE} Table")  
        except Exception as e:    
            print(f"Error {e} while writing to BALANCE oracle table.")

            log_etl(spark, process_run_id, "PL_Posting_Balance",3, f"Failed While posting balances Reason: {e}.") 
            spark.stop()
            sys.exit(1)

            
        log_etl(spark, process_run_id, "PL_Posting_Data_Datalake",1,f"Started posting in {GL_DATALAKE_PATH} Datalake")      

        try:
             
             source_df = read_oracle(spark, load_balance_sql)
             source_df = source_df.select(
                concat(col("BRANCH_CODE"),col("CURRENCY"),col("CGL")).alias("glcc"),
                col("BALANCE").alias("balance"),
                col("INR_BALANCE").alias("inr_balance"),
                col("BALANCE_DATE").alias("balance_date")
             )
             source_df.show(10,False)
             target_data = spark.read.format("delta").load(GL_DATALAKE_PATH)
             target_data.show(10,False)
             delta_table = DeltaTable.forPath(
                spark,
                GL_DATALAKE_PATH
             )
             
             delta_table.alias("target").merge(
                source_df.alias("source"),
                """
                target.glcc = source.glcc
                AND target.BALANCE_DATE = source.balance_date
                """
             ).whenMatchedUpdate(
                set={
                    "closing_balance": "coalesce(target.closing_balance,0) + coalesce(source.balance,0)",
                    "INR_BALANCE":"coalesce(target.inr_balance,0) + coalesce(source.inr_balance,0)"
                }
             ).whenNotMatchedInsert(
                values={
                    "glcc": "source.glcc",
                    "closing_balance": "source.balance",
                    "inr_balance":"inr_balance",
                    "BALANCE_DATE": "source.balance_date"
                }
             ).execute()

             log_etl(spark, process_run_id, "PL_Posting_Data_Datalake",2, f"Successfully posting to {GL_DATALAKE_PATH} Datalake")
        except Exception as e:    
            print(f"Error {e} while writing to Datalake.")
            log_etl(spark, process_run_id, "PL_Posting_Data_Datalake",3, f"Failed While posting balances to datalake Reason: {e}.")
            spark.stop()
            sys.exit(1)

        log_etl(spark, process_run_id, "PL_Posting_transactions",1,f"Started posting in {TRANSACTIONS} Table")
        try:
            write_oracle(load_transactions, "GL_TRANSACTIONS")
            log_etl(spark, process_run_id, "PL_Posting_transactions",2, "Successfully Transfered of Transactions")
        except Exception as e:    
            print(f"Error {e} while writing to TRANSACTIONS oracle Table.")
            log_etl(spark, process_run_id, "PL_Posting_transactions",3, f"Failed While posting Transactions. Reason: {e}.")
            spark.stop()
            sys.exit(1)
        log_etl(spark, process_run_id, "PL_Posting",2,"Profit and Loss Successfully Posted.")
    except Exception as e:
        print(f"Error {e} while posting Profit and Loss.")  
        log_etl(spark, process_run_id, "PL_Posting",3,f"Failed While posting Profit and Loss. Reason {e}.")  
        spark.stop()
        sys.exit(1)

    spark.stop()
    sys.exit(0)




if __name__=="__main__":
    
    main(sys.argv)   
    
